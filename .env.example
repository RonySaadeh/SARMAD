ANTHROPIC_API_KEY=
# Used for project scaffolding specifically; not the voice chat model (see below).
ANTHROPIC_MODEL=claude-sonnet-5

# Voice chat uses FAST_MODEL by default; say "use Opus" / "use your smartest
# model" to switch to SMART_MODEL for a hard task, or "use your fast model" /
# "go back to normal" to switch back. The choice sticks until you change it again.
FAST_MODEL=claude-haiku-4-5-20251001
SMART_MODEL=claude-opus-5

# Local speech-to-text (faster-whisper, no key needed). Bigger = more accurate but slower on CPU.
# Options: tiny, base, small, medium. If it's still too slow on your machine, try "base";
# if it's still mishearing words, try "medium".
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu

# Free text-to-speech voices (edge-tts, no key needed). List others with: edge-tts --list-voices
# EDGE_TTS_VOICE is used for English replies; ARABIC_TTS_VOICE is used automatically
# whenever a reply contains Arabic script, so bilingual conversations sound right.
EDGE_TTS_VOICE=en-US-GuyNeural
ARABIC_TTS_VOICE=ar-SA-HamedNeural

# Folder containing an unzipped Vosk model, e.g. vosk-model-small-en-us-0.15
# Download from https://alphacephei.com/vosk/models
VOSK_MODEL_PATH=./vosk-model-small-en-us-0.15

# Where "create a project" scaffolds new folders
PROJECTS_DIR=./Projects

# Optional: apps.json is only needed for custom aliases/paths — by default
# open_app also searches your Start Menu automatically, so most installed
# apps work without registering them here.
APPS_CONFIG_PATH=./apps.json

# Must be explicitly set to "true" to allow shutdown/sleep/lock voice commands
ENABLE_POWER_ACTIONS=false

# Show the JARVIS-style HUD window. Set to "false" to run headless (terminal only).
ENABLE_HUD=true

# Which webcam to use for "look at this" (0 = default/first camera). If you have
# multiple cameras and the wrong one activates, try 1, 2, etc.
CAMERA_INDEX=0

# Lets SARMAD fix/extend an existing project by delegating to the Claude Code
# CLI (`claude`), scoped to that project's folder. Requires the CLI installed
# and logged in on this machine (claude login) and is off by default because
# it runs with permission prompts bypassed so it can work unattended.
ENABLE_CODING_AGENT=false

# Email (IMAP read + reply). Use an app password, not your real password:
# Gmail: https://myaccount.google.com/apppasswords (needs 2FA enabled first)
# Outlook: imap-mail.outlook.com / smtp-mail.outlook.com
# Yahoo:   imap.mail.yahoo.com / smtp.mail.yahoo.com
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# false (default): replying opens a pre-filled draft in your mail client, you hit send.
# true: SARMAD sends the email itself via SMTP, no confirmation step.
ENABLE_EMAIL_SEND=false

# Calendar (read-only feed + "add event" drafting). For Google Calendar:
# Settings > [your calendar] > "Secret address in iCal format". Works with any
# calendar that publishes an ICS feed (Outlook, iCloud, etc). Leave blank to
# disable check_calendar.
CALENDAR_ICS_URL=
