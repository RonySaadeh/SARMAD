ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_TTS_VOICE=alloy

# Folder containing an unzipped Vosk model, e.g. vosk-model-small-en-us-0.15
# Download from https://alphacephei.com/vosk/models
VOSK_MODEL_PATH=./vosk-model-small-en-us-0.15

# Where "create a project" scaffolds new folders
PROJECTS_DIR=./Projects

# Path to your apps.json (copy apps.json.example -> apps.json and edit it)
APPS_CONFIG_PATH=./apps.json

# Must be explicitly set to "true" to allow shutdown/sleep/lock voice commands
ENABLE_POWER_ACTIONS=false
